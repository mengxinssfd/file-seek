{
  "name": "file-seek",
  "version": "0.0.0",
  "packageManager": "pnpm@9.3.0",
  "description": "文件查找",
  "scripts": {
    "test": "jest",
    "test:cov": "jest --coverage",
    "prepare": "husky install",
    "husky-msg-init": "husky add .husky/pre-commit \"npx lint-staged --allow-empty \"$1\"\"&husky add .husky/commit-msg \"npx commitlint --edit \"$1\"\"",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "check:deps": "ncu",
    "check:ts.node": "tsc -p ./tsconfig.node.json --noEmit",
    "check:ts": "tsc --noEmit && npm run check:ts.node",
    "check:eslint": "eslint .",
    "check:prettier": "prettier ./ --check",
    "check:all": "run-p check:ts check:eslint check:prettier"
  },
  "lint-staged": {
    "*.{json,html,md,yaml}": [
      "prettier --write",
      "git add"
    ],
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint",
      "git add"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mengxinssfd/file-seek.git"
  },
  "keywords": [
    "file",
    "seek"
  ],
  "author": "dyh_w",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mengxinssfd/file-seek/issues"
  },
  "homepage": "https://github.com/mengxinssfd/file-seek#readme",
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@tool-pack/basic": "^0.9.1",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.12",
    "@types/minimist": "^1.2.5",
    "@types/node": "^25.2.2",
    "@types/semver": "^7.5.8",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "chalk": "^5.3.0",
    "conventional-changelog-cli": "^5.0.0",
    "core-js": "^3.37.1",
    "enquirer": "^2.4.1",
    "eslint": "9.26.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsdoc": "^48.2.12",
    "eslint-plugin-perfectionist": "^2.11.0",
    "eslint-plugin-prettier": "^5.1.3",
    "execa": "^9.2.0",
    "fs-extra": "^11.2.0",
    "gh-pages": "^6.1.1",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.2.7",
    "minimist": "^1.2.8",
    "npm-check-updates": "^16.14.20",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.2",
    "rimraf": "^5.0.7",
    "sass": "^1.77.5",
    "semver": "^7.6.2",
    "ts-jest": "^29.1.4",
    "tslib": "^2.6.3",
    "tsx": "^4.15.5",
    "typescript": "^5.4.5",
    "typescript-eslint": "^7.13.0"
  }
}
